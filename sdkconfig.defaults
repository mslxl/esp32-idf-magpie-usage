CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_FREERTOS_HZ=1000
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Keep bonding records in the default "nvs" partition so re-entering setup or
# rebooting reuses an existing pairing. Settings remain in "note4_cfg".
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Let the application decide whether a stale bond may be replaced; it keeps the
# passkey-authentication and bonding requirements for the new pairing.
CONFIG_BT_NIMBLE_HANDLE_REPEAT_PAIRING_DELETION=n
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Keep TLS buffers in PSRAM so Wi-Fi, EPD and bounded quota reads retain internal RAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# Reuse TLS sessions between the sign-in and quota requests and later polls.
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=y
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y
# Dynamic frequency scaling with automatic light sleep while idle. Wi-Fi uses
# modem sleep (WIFI_PS_MAX_MODEM); BLE runs only during setup and holds a
# no-light-sleep lock; development builds disable light sleep for USB-Serial-JTAG.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
# BLE notifications use the negotiated ATT MTU (up to 192-byte frame payloads).
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
